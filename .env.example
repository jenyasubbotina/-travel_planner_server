# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/travel_planner
DATABASE_USER=tp_user
DATABASE_PASSWORD=tp_pass

# JWT
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_ISSUER=travel-planner
JWT_AUDIENCE=travel-planner-client
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=travel-planner
S3_REGION=us-east-1

# FCM (optional — set path to Firebase service account JSON)
FCM_SERVICE_ACCOUNT_PATH=

# Public URL of this API (no trailing slash) — used in verification emails
PUBLIC_API_BASE_URL=http://localhost:8080
# Optional: browser redirects after GET /api/v1/auth/verify-email
# EMAIL_VERIFY_SUCCESS_REDIRECT_URL=https://app.example.com/email-verified
# EMAIL_VERIFY_FAILURE_REDIRECT_URL=https://app.example.com/email-verify-failed

# SMTP (Jakarta Mail) — для prod задайте SMTP_PASSWORD в .env на сервере (не в git)
# SMTP_ENABLED=true
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_TLS_MODE=ssl
# SMTP_USERNAME=you@yandex.ru
# SMTP_PASSWORD=   # обязательно на сервере, если SMTP_ENABLED=true
# SMTP_FROM=you@yandex.ru

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Docker Compose prod: image ref (same as GitHub DOCKERHUB_USERNAME/travel-planner-server)
APP_IMAGE=YOUR_DOCKERHUB_USERNAME/travel-planner-server:latest
